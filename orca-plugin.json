{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "bot-office",
  "name": "Bot Office",
  "version": "0.7.0",
  "description": "Ultra-lightweight illustrated 2.5D modern office tower, Decision Report Queue & team workload SVG analytics dashboard in Orca's right sidebar.",
  "license": "MIT",
  "icon": "assets/icon.png",
  "screenshots": [
    {
      "path": "assets/screenshot.png",
      "alt": "Bot Office illustrated 2.5D modern office floors alongside a team workload analytics dashboard with stacked bars, 7-day trend, engine donut and token usage",
      "caption": "2.5D illustrated office tower + lightweight SVG team workload & token analytics dashboard"
    }
  ],
  "engines": {
    "orca": ">=1.4.259"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "office",
        "title": "Bot Office",
        "icon": "bot",
        "ui": "html",
        "entry": "panel/index.html"
      }
    ],
    "commands": [
      {
        "id": "bot-office.show",
        "title": "Bot Office: Open Office View"
      },
      {
        "id": "bot-office.refresh",
        "title": "Bot Office: Refresh Status"
      }
    ],
    "statusBarItems": [
      {
        "id": "bot-office-status",
        "icon": "bot",
        "text": "Bot Office",
        "tooltip": "Open Bot Office in the right sidebar",
        "command": "bot-office.show"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.created" },
      { "on": "workspace.removed" },
      { "on": "workspace.changed" }
    ],
    "settings": [
      {
        "key": "refreshIntervalSeconds",
        "title": "Background Fallback Refresh Interval (seconds)",
        "type": "integer",
        "default": 25,
        "minimum": 8,
        "maximum": 120
      },
      {
        "key": "soloBotsInLounge",
        "title": "Group solo Bots (0 Workers) in the Open Workspace & Coffee Lounge",
        "type": "boolean",
        "default": true
      },
      {
        "key": "hideStaleIdleHours",
        "title": "Auto-collapse idle Workers older than N hours (0 = show all)",
        "type": "integer",
        "default": 24,
        "minimum": 0,
        "maximum": 168
      },
      {
        "key": "showStandaloneWorkspaces",
        "title": "Show standalone workspaces in B1 Hot-Desk Bar",
        "type": "boolean",
        "default": true
      },
      {
        "key": "language",
        "title": "UI Language",
        "type": "string",
        "enum": ["auto", "en", "zh"],
        "default": "auto"
      }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:read" },
    { "kind": "history:read" },
    { "kind": "settings:own" }
  ]
}
